# Copy to .env and fill in as needed. All of these are optional.

DAIRYPRO_SECRET_KEY=change-me-to-a-long-random-string
DAIRYPRO_TOKEN_EXPIRE_DAYS=7
DAIRYPRO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DAIRYPRO_DB_PATH=./dairypro.db

# Optional: enables real AI insights (milk/health/breeding narrative).
# Without it, the app still works — analytics are computed from your data,
# just without the LLM-written narrative summary.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: enables real outgoing email for user invites / shopping list alerts.
# Without it, emails are logged to backend/var/sent_emails.log instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DairyPro <no-reply@example.com>
SMTP_TLS=true
